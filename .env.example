# Salin ke `.env` di mesin build (lokal atau CI) SEBELUM `bun run build`.
# Jangan commit `.env` — file ini adalah template kosong yang boleh di-commit.
#
# ============================================================
# PENTING — dua kelompok env, dua momen berbeda:
#
# 1) VITE_*  → dibaca oleh Vite saat BUILD dan di-inline ke bundle browser.
#              Wajib ada saat menjalankan `bun run build`.
#              Kalau kosong → browser gagal init Supabase → halaman
#              "Terjadi kesalahan" muncul di production.
#
# 2) SUPABASE_* (tanpa prefix VITE_) → dibaca oleh Worker saat RUNTIME.
#              Jangan taruh di file ini untuk production. Gunakan:
#                wrangler secret put SUPABASE_URL
#                wrangler secret put SUPABASE_PUBLISHABLE_KEY
#                wrangler secret put SUPABASE_SERVICE_ROLE_KEY
#                wrangler secret put SUPABASE_PROJECT_ID
#              (ulangi dengan untuk worker dev)
# ============================================================

# ---------- Client (BUILD-TIME, di-bundle ke browser) ----------
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx_or_anon_jwt"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# ---------- Server (opsional untuk dev lokal `bun run dev`) ----------
# Untuk production Cloudflare Workers, JANGAN commit nilainya — pakai `wrangler secret put`.
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx_or_anon_jwt"
SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxx_or_service_role_jwt"
